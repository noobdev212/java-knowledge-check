<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>

<VBox
  fx:id="rootPane"
  xmlns="http://javafx.com/javafx"
  xmlns:fx="http://javafx.com/fxml"
  stylesheets="@../css/Style.css"
  fx:controller="com.noobdev.QuestionDialogController"
>
  <Label text="Build Your Question"/>
  <Label text="Question"/>
  <TextField fx:id="questionTF" promptText="enter your question..."/>
  <Label text="Answer"/>
  <TextField fx:id="answerTF" promptText="your answer is..."/>
  <HBox spacing="10">
    <Button fx:id="createBtn" text="Create" onAction="#createQuestion"/>
    <Button fx:id="cancelBtn" text="Cancel" onAction="#closeDialog"/>
  </HBox>
</VBox>
