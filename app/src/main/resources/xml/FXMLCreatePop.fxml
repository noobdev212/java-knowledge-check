<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>

<VBox
  fx:id="rootPane"
  xmlns="http://javafx.com/javafx"
  xmlns:fx="http://javafx.com/fxml"
  stylesheets="@../css/Style.css"
  fx:controller="com.noobdev.CreateDialogController"
>
  <Label text="Build Your Assessment"/>
  <Label text="Name of Assessment"/>
  <TextField fx:id="nameTF" promptText="name of your quiz..."/>
  <Label text="Description"/>
  <TextField fx:id="descTF" promptText="write your description..."/>
  <Label text="Choose Algorithm"/>
  <ComboBox fx:id="algoCB" promptText="choose your preferred nlp..."/>
  <HBox spacing="10">
    <Button fx:id="createBtn" text="Create" onAction="#createAssessment"/>
    <Button fx:id="cancelBtn" text="Cancel" onAction="#closeDialog"/>
  </HBox>
</VBox>
